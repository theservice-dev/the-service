{%- doc -%}
  Renders a placeholder image for products that have no media when the
  global "Placeholder image preview" feature is enabled in theme settings.

  Each placeholder group can hold up to 6 images. For an imageless product,
  every image from every group whose collections / categories filter matches
  the product is added to a pool; if no group matches, every image from the
  groups with no filter (the "general" pool) is used instead. One image is
  picked deterministically from the pool using the product's id, so the same
  product always shows the same placeholder, and neighbouring products are
  spread across the available images. A subtle "Placeholder" tag is overlaid
  so the image is never mistaken for real product content.

  This is a temporary preview-only feature meant to visualize how the storefront
  will look once every product has real media. Disable the global toggle once
  real images are uploaded.

  Renders nothing when:
    - `settings.show_imageless_placeholder` is false
    - the product already has media (`product.media.size > 0`)
    - the merchant has not picked any placeholder images

  @param {object} product - The product object (required).
  @param {string} [widths] - The widths attribute for the responsive image.
  @param {string} [sizes] - The sizes attribute for the responsive image.
  @param {string} [loading] - The loading attribute for the image (default 'lazy').
  @param {string} [class] - Additional classes on the <img> element.
  @param {string} [style] - Additional inline styles on the <img> element.
  @param {string} [wrapper_class] - Additional classes on the wrapper <div>.

  @example
  {% render 'product-placeholder-image',
    product: product,
    sizes: '(min-width: 750px) 50vw, 100vw',
    loading: 'lazy'
  %}
{%- enddoc -%}

{%- liquid
  assign product_type_normalized = product.type | default: '' | downcase | strip
  assign product_title_normalized = product.title | default: '' | downcase

  assign product_tags_normalized = '|'
  for tag_value in product.tags
    assign tag_clean = tag_value | downcase | strip
    assign product_tags_normalized = product_tags_normalized | append: tag_clean | append: '|'
  endfor

  assign product_collection_ids = '|'
  for c in product.collections
    assign product_collection_ids = product_collection_ids | append: c.id | append: '|'
  endfor

  assign matching_keys = ''
  assign general_keys = ''
  for i in (1..6)
    assign primary_key = 'placeholder_image_' | append: i
    assign primary_img = settings[primary_key]
    if primary_img == blank
      continue
    endif

    assign coll_key = 'placeholder_image_' | append: i | append: '_collections'
    assign picked_collections = settings[coll_key]
    assign has_collection_filter = false
    if picked_collections != blank and picked_collections.size > 0
      assign has_collection_filter = true
    endif

    assign cat_key = 'placeholder_image_' | append: i | append: '_categories'
    assign cats_raw = settings[cat_key] | default: ''
    assign cats_clean = cats_raw | strip
    assign has_category_filter = false
    if cats_clean != ''
      assign has_category_filter = true
    endif

    assign is_general = false
    if has_collection_filter == false and has_category_filter == false
      assign is_general = true
    endif

    assign is_match = false
    if has_collection_filter
      for picked in picked_collections
        assign id_marker = '|' | append: picked.id | append: '|'
        if product_collection_ids contains id_marker
          assign is_match = true
          break
        endif
      endfor
    endif

    if is_match == false and has_category_filter
      assign cat_list = cats_clean | downcase | split: ','
      for c in cat_list
        assign c_clean = c | strip
        if c_clean == ''
          continue
        endif
        if c_clean == product_type_normalized
          assign is_match = true
          break
        endif
        assign tag_marker = '|' | append: c_clean | append: '|'
        if product_tags_normalized contains tag_marker
          assign is_match = true
          break
        endif
        if product_title_normalized contains c_clean
          assign is_match = true
          break
        endif
      endfor
    endif

    if is_general == false and is_match == false
      continue
    endif

    assign group_keys = i | append: ','
    for v in (2..6)
      assign vkey = 'placeholder_image_' | append: i | append: '_' | append: v
      assign vimg = settings[vkey]
      if vimg != blank
        assign vsuffix = i | append: '_' | append: v
        assign group_keys = group_keys | append: vsuffix | append: ','
      endif
    endfor

    if is_match
      assign matching_keys = matching_keys | append: group_keys
    elsif is_general
      assign general_keys = general_keys | append: group_keys
    endif
  endfor

  assign matching_arr = matching_keys | split: ','
  assign general_arr = general_keys | split: ','

  assign selected_arr = matching_arr
  if selected_arr.size == 0
    assign selected_arr = general_arr
  endif

  assign chosen = blank
  if selected_arr.size > 0
    assign target = product.id | modulo: selected_arr.size
    assign chosen_key_suffix = selected_arr[target]
    assign chosen_setting_key = 'placeholder_image_' | append: chosen_key_suffix
    assign chosen = settings[chosen_setting_key]
  endif

  assign should_render = false
  if settings.show_imageless_placeholder and product != blank and product.media.size == 0 and chosen != blank
    assign should_render = true
  endif

  assign image_loading = loading | default: 'lazy'
  assign image_widths = widths | default: '240, 352, 832, 1200, 1600, 1920, 2560, 3840'
  assign image_class = class | default: ''
  assign wrapper_extra_class = wrapper_class | default: ''
-%}

{%- if should_render -%}
  {%- capture placeholder_alt -%}{{- 'placeholder.alt_for_product' | t: title: product.title -}}{%- endcapture -%}
  <div
    class="placeholder-preview {{ wrapper_extra_class }}"
    data-placeholder-preview="true"
  >
    {{
      chosen
      | image_url: width: 3840
      | image_tag:
        widths: image_widths,
        sizes: sizes,
        loading: image_loading,
        class: image_class,
        alt: placeholder_alt,
        style: style
    }}
    <span
      class="placeholder-preview__tag"
      aria-label="{{ 'placeholder.tag_aria' | t }}"
    >
      {{- 'placeholder.tag' | t -}}
    </span>
  </div>
{%- endif -%}

{% stylesheet %}
  .placeholder-preview {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: var(--gallery-aspect-ratio, var(--ratio, 1));
    overflow: hidden;
  }

  .placeholder-preview > img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  /* Subtle, almost imperceptible tag in the corner of the image.
     The text content + aria-label still expose the meaning to screen readers
     and keyboard users at full contrast. */
  .placeholder-preview__tag {
    position: absolute;
    bottom: 0.5rem;
    right: 0.5rem;
    z-index: 2;
    padding: 0.125rem 0.5rem;
    border-radius: 999px;
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-5));
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
    font-size: 0.6875rem;
    line-height: 1.4;
    letter-spacing: 0.02em;
    opacity: 0.5;
    text-transform: lowercase;
    pointer-events: none;
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
  }

  /* Restore full contrast for users who need it. WCAG 1.4.11 compliance. */
  @media (prefers-contrast: more) {
    .placeholder-preview__tag {
      opacity: 1;
      color: var(--color-foreground);
      background-color: var(--color-background);
      border: 1px solid currentColor;
    }
  }

  @media (forced-colors: active) {
    .placeholder-preview__tag {
      opacity: 1;
      forced-color-adjust: none;
      color: CanvasText;
      background-color: Canvas;
      border: 1px solid CanvasText;
    }
  }
{% endstylesheet %}
